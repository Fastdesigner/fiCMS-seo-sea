{
  "id": "fiCMS-seo-sea",
  "name": "fiCMS SEO/SEA",
  "type": "thirdparty",
  "system": false,
  "description": "Adds SEO, SEA, visibility and lead management workflows for fiCMS.",
  "version": "1.0.0",
  "dependencies": {
    "oauth": {
      "type": "system",
      "required": true
    },
    "google": {
      "owner": "Fastdesigner",
      "repo": "google",
      "branch": "main",
      "installLocation": "PLUGINPATH/google",
      "required": true
    },
    "meta": {
      "owner": "Fastdesigner",
      "repo": "meta",
      "branch": "main",
      "installLocation": "PLUGINPATH/meta",
      "required": true
    }
  },
  "autoload": {
    "psr4": {
      "ficmsSeoSea\\": "src/"
    }
  },
  "requires": [
    "ficms\\Files::ensureDirectoryFor",
    "ficms\\Settings::set"
  ]
}
